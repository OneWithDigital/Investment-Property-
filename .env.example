# Copy this file to .env and fill in real values.

# Postgres connection string. For local dev, run a local Postgres instance
# (e.g. `apt install postgresql`, or Docker: `docker run -p 5432:5432 -e
# POSTGRES_PASSWORD=app postgres:16`) and create a database, or use a free
# hosted instance (Neon, Supabase, Railway, Vercel Postgres, etc.).
DATABASE_URL="postgresql://user:password@localhost:5432/investment_property"

# Generate a real secret for production: `openssl rand -base64 32`
NEXTAUTH_SECRET="dev-only-secret-change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Comma-separated email addresses that get promoted to the ADMIN role
# (unlocking /admin) the next time they log in. This is a one-way
# bootstrap, not a live allowlist: after promotion, roles are managed
# from the admin Users page, and removing an email here does not demote
# it. Leave empty/unset to disable admin bootstrapping entirely.
ADMIN_EMAILS=""

# Optional: enables the MLS/comps lookup (RentCast). Without this the
# comps lookup feature degrades gracefully and tells the user it's not
# configured. Get a key at https://www.rentcast.io/api
RENTCAST_API_KEY=""

# Optional: enables real email delivery for account verification and
# password reset. Without SMTP config, those emails are logged to the
# server console instead (dev-mode fallback) rather than failing.
EMAIL_FROM="Investment Property Analyzer <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
