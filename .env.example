# Copy this file to .env and fill in real values.

# SQLite for local dev. For production, point this at a real Postgres/MySQL
# database (Prisma supports swapping the provider in prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Generate a real secret for production: `openssl rand -base64 32`
NEXTAUTH_SECRET="dev-only-secret-change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Optional: enables the MLS/comps lookup (RentCast). Without this the
# comps lookup feature degrades gracefully and tells the user it's not
# configured. Get a key at https://www.rentcast.io/api
RENTCAST_API_KEY=""
