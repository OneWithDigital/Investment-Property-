# next-auth@4 declares an *optional* peer dependency on nodemailer@^7
# (only used by its built-in EmailProvider, which this app doesn't use —
# auth is credentials-based). We pin nodemailer to 9.0.5+ instead, since
# every nodemailer release through 9.0.0 has known CRLF-injection CVEs
# with no fix in the 7.x/8.x lines. That creates an unavoidable peer-dep
# mismatch that npm's strict resolver blocks on by default; this relaxes
# it project-wide so `npm install`/`npm ci` succeed.
legacy-peer-deps=true
